#!/bin/bash
# Coalesce Rift → SketchyBar bursts so a layout/focus flurry only redraws once.
set -euo pipefail
stamp=/tmp/rift-sbar-refresh.stamp
token="$$.$RANDOM.$(date +%s%N)"
printf '%s' "$token" >"$stamp"
(
  sleep 0.05
  [[ "$(cat "$stamp" 2>/dev/null || true)" == "$token" ]] || exit 0
  /opt/homebrew/bin/sketchybar --trigger rift_workspace_changed >/dev/null 2>&1 || true
) &
