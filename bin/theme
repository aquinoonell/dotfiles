#!/bin/bash
#
# Theme Switcher - Switch nvim, kitty, borders, and wallpaper themes
# Usage: theme <theme-name> | theme --list | theme --current
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
TEMPLATES_DIR="$DOTFILES_DIR/templates"
CURRENT_THEME_FILE="$HOME/.current-theme"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_info() { echo -e "${BLUE}→${NC} $1"; }

# List available themes
list_themes() {
    echo -e "${BLUE}Available themes:${NC}"
    for theme in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme")
        if [[ -f "$CURRENT_THEME_FILE" ]] && [[ "$(cat "$CURRENT_THEME_FILE")" == "$theme_name" ]]; then
            echo -e "  ${GREEN}● $theme_name${NC} (current)"
        else
            echo "  ○ $theme_name"
        fi
    done
}

# Show current theme
show_current() {
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        echo "$(cat "$CURRENT_THEME_FILE")"
    else
        echo "No theme set"
    fi
}

# Parse TOML value (simple key = "value" parser)
get_toml_value() {
    local file="$1"
    local key="$2"
    grep "^$key = " "$file" 2>/dev/null | sed 's/.*= "\(.*\)"/\1/' | head -1
}

# Convert hex color to 0xff format for borders
hex_to_borders() {
    local hex="$1"
    echo "0xff${hex:1}"
}

# Fill template with colors
fill_template() {
    local template="$1"
    local output="$2"
    local colors_file="$3"
    local theme_name="$4"
    
    local content
    content=$(cat "$template")
    
    # Replace theme name
    content="${content//\{\{THEME_NAME\}\}/$theme_name}"
    
    # Replace colors
    local keys=(
        "background" "dark_background" "darker_background" "lighter_background"
        "foreground" "dark_foreground" "light_foreground" "bright_foreground"
        "accent" "selection" "muted"
        "red" "yellow" "orange" "green" "cyan" "blue" "magenta" "brown"
        "bright_red" "bright_yellow" "bright_green" "bright_cyan" "bright_blue" "bright_magenta"
    )
    
    for key in "${keys[@]}"; do
        local value
        value=$(get_toml_value "$colors_file" "$key")
        if [[ -n "$value" ]]; then
            content="${content//\{\{$key\}\}/$value}"
        fi
    done
    
    # Replace hex versions for borders (0xff format)
    local accent muted_color
    accent=$(get_toml_value "$colors_file" "accent")
    muted_color=$(get_toml_value "$colors_file" "muted")
    
    content="${content//\{\{accent_hex\}\}/$(hex_to_borders "$accent")}"
    content="${content//\{\{muted_hex\}\}/$(hex_to_borders "$muted_color")}"
    
    echo "$content" > "$output"
}

# Get neovim colorscheme from theme
get_nvim_colorscheme() {
    local theme_dir="$1"
    local nvim_file="$theme_dir/neovim.lua"
    
    if [[ -f "$nvim_file" ]]; then
        # Extract colorscheme name from the lua file
        grep "colorscheme" "$nvim_file" | sed 's/.*colorscheme = "\([^"]*\)".*/\1/' | head -1
    else
        # No dedicated plugin — OmarchyApplyTheme will use colors.toml
        echo "omarchy-$(basename "$theme_dir")"
    fi
}

# Get neovim plugin from theme
get_nvim_plugin() {
    local theme_dir="$1"
    local nvim_file="$theme_dir/neovim.lua"
    
    if [[ -f "$nvim_file" ]]; then
        # Extract plugin name (first quoted string that looks like a plugin)
        grep -E '^\s*"[^/]+/[^"]+"' "$nvim_file" | head -1 | sed 's/.*"\([^"]*\)".*/\1/'
    else
        echo ""
    fi
}

# Set desktop wallpaper
set_wallpaper() {
    local theme_dir="$1"
    local backgrounds_dir="$theme_dir/backgrounds"
    
    if [[ -d "$backgrounds_dir" ]]; then
        # Get the first available wallpaper
        local wallpaper
        wallpaper=$(ls "$backgrounds_dir"/*.{jpg,jpeg,png,webp} 2>/dev/null | head -1)
        
        if [[ -n "$wallpaper" && -f "$wallpaper" ]]; then
            osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$wallpaper\"" 2>/dev/null
            print_success "Wallpaper set"
        else
            print_info "No wallpaper found for this theme"
        fi
    else
        print_info "No backgrounds directory for this theme"
    fi
}

# Write bordersrc config file for brew service restarts
write_bordersrc() {
    local accent="$1"
    local muted="$2"
    
    mkdir -p "$HOME/.config/borders"
    cat > "$HOME/.config/borders/bordersrc" << EOF
#!/bin/bash
borders active_color="$accent" inactive_color="$muted" width=6.0
EOF
    chmod +x "$HOME/.config/borders/bordersrc"
}

# Apply borders colors (IPC update if running, start via brew if not)
restart_borders() {
    local accent="$1"
    local muted="$2"
    
    # Respect user preference (borders-toggle off)
    if [[ -f "$HOME/.borders-disabled" ]]; then
        print_info "Borders disabled (run borders-toggle on to enable)"
        return
    fi
    
    # Always write bordersrc so brew service restarts stay themed
    write_bordersrc "$accent" "$muted"
    
    # If borders is running, IPC update (no pkill needed)
    if pgrep -x borders >/dev/null; then
        borders active_color="$accent" inactive_color="$muted" width=6.0
        print_success "Borders updated ($accent)"
        return
    fi
    
    # Not running — start via brew services (launchd-managed)
    if command -v brew &>/dev/null && brew services list 2>/dev/null | grep -q "^borders"; then
        brew services start borders 2>/dev/null || true
        sleep 0.3
        # IPC apply colors after brew starts it
        if pgrep -x borders >/dev/null; then
            borders active_color="$accent" inactive_color="$muted" width=6.0
            print_success "Borders started via brew ($accent)"
            return
        fi
    fi
    
    # Fallback: start directly (bordersrc will apply colors on next brew restart)
    borders active_color="$accent" inactive_color="$muted" width=6.0 &
    disown
    sleep 0.2
    if pgrep -x borders >/dev/null; then
        print_success "Borders started ($accent)"
    else
        print_info "Borders failed to start — try: borders-toggle on"
    fi
}

# Signal neovim to reload colorscheme
signal_nvim() {
    local theme_name="$1"
    local colorscheme="$2"
    local plugin="$3"
    
    # Write to files for next nvim startup
    echo "$colorscheme" > "$HOME/.nvim-colorscheme"
    echo "$plugin" > "$HOME/.nvim-colorscheme-plugin"
    
    # Send full theme apply to all running nvim instances
    if command -v nvr &>/dev/null; then
        local found=0
        # Use OmarchyApplyTheme which loads plugins + falls back to colors.toml
        # Keep everything inside :lua — "|" after :lua is invalid Lua
        local reload_cmd="<Esc>:lua if OmarchyApplyTheme then OmarchyApplyTheme('${theme_name}') end; pcall(vim.cmd, 'AirlineRefresh'); vim.cmd('redraw!')<CR>"
        
        # Fast socket search (macOS TMPDIR + /tmp only, limited depth)
        local search_roots=()
        [[ -n "${TMPDIR:-}" ]] && search_roots+=("$TMPDIR")
        search_roots+=("/tmp")
        
        while IFS= read -r sock; do
            if [[ -S "$sock" ]]; then
                nvr --servername "$sock" --remote-send "$reload_cmd" 2>/dev/null || true
                found=1
            fi
        done < <(find "${search_roots[@]}" -maxdepth 4 -name 'nvim.*.0' -type s 2>/dev/null)
        
        if [[ $found -eq 1 ]]; then
            print_success "Neovim theme: $theme_name (reloaded)"
        else
            print_success "Neovim theme set to: $theme_name"
        fi
    else
        print_success "Neovim theme set to: $theme_name"
        print_info "Restart nvim to apply (install neovim-remote for live reload)"
    fi
}

# Main theme switch function
switch_theme() {
    local theme_name="$1"
    local theme_dir="$THEMES_DIR/$theme_name"
    local colors_file="$theme_dir/colors.toml"
    
    # Validate theme exists
    if [[ ! -d "$theme_dir" ]]; then
        print_error "Theme '$theme_name' not found"
        echo "Run 'theme --list' to see available themes"
        exit 1
    fi
    
    if [[ ! -f "$colors_file" ]]; then
        print_error "No colors.toml found for theme '$theme_name'"
        exit 1
    fi
    
    echo -e "${BLUE}Switching to theme: ${YELLOW}$theme_name${NC}"
    echo ""
    
    # 1. Generate Kitty theme config
    local kitty_conf="$HOME/.config/kitty/current-theme.conf"
    if [[ -d "$HOME/.config/kitty" ]]; then
        local bg fg cursor sel
        bg=$(get_toml_value "$colors_file" "background")
        fg=$(get_toml_value "$colors_file" "foreground")
        cursor=$(get_toml_value "$colors_file" "foreground")
        sel=$(get_toml_value "$colors_file" "selection")
        
        local black red green yellow blue magenta cyan white
        black=$(get_toml_value "$colors_file" "background")
        red=$(get_toml_value "$colors_file" "red")
        green=$(get_toml_value "$colors_file" "green")
        yellow=$(get_toml_value "$colors_file" "yellow")
        blue=$(get_toml_value "$colors_file" "blue")
        magenta=$(get_toml_value "$colors_file" "magenta")
        cyan=$(get_toml_value "$colors_file" "cyan")
        white=$(get_toml_value "$colors_file" "muted")
        
        local bright_black bright_red bright_green bright_yellow bright_blue bright_magenta bright_cyan bright_white
        bright_black=$(get_toml_value "$colors_file" "muted")
        bright_red=$(get_toml_value "$colors_file" "bright_red")
        [[ -z "$bright_red" ]] && bright_red="$red"
        bright_green=$(get_toml_value "$colors_file" "bright_green")
        [[ -z "$bright_green" ]] && bright_green="$green"
        bright_yellow=$(get_toml_value "$colors_file" "bright_yellow")
        [[ -z "$bright_yellow" ]] && bright_yellow="$yellow"
        bright_blue=$(get_toml_value "$colors_file" "bright_blue")
        [[ -z "$bright_blue" ]] && bright_blue="$blue"
        bright_magenta=$(get_toml_value "$colors_file" "bright_magenta")
        [[ -z "$bright_magenta" ]] && bright_magenta="$magenta"
        bright_cyan=$(get_toml_value "$colors_file" "bright_cyan")
        [[ -z "$bright_cyan" ]] && bright_cyan="$cyan"
        bright_white=$(get_toml_value "$colors_file" "foreground")
        
        cat > "$kitty_conf" << EOF
# ${theme_name} theme for Kitty
# Generated by theme switcher

foreground ${fg}
background ${bg}
cursor ${cursor}
cursor_text_color ${bg}
selection_foreground ${fg}
selection_background ${sel:-#504945}

# Black
color0 ${black}
color8 ${bright_black}

# Red
color1 ${red}
color9 ${bright_red}

# Green
color2 ${green}
color10 ${bright_green}

# Yellow
color3 ${yellow}
color11 ${bright_yellow}

# Blue
color4 ${blue}
color12 ${bright_blue}

# Magenta
color5 ${magenta}
color13 ${bright_magenta}

# Cyan
color6 ${cyan}
color14 ${bright_cyan}

# White
color7 ${white}
color15 ${bright_white}
EOF
        # Signal Kitty to reload
        if pgrep -x kitty >/dev/null; then
            kill -SIGUSR1 $(pgrep -x kitty) 2>/dev/null || true
        fi
        print_success "Kitty theme updated"
    fi
    
    # 2. Restart borders with new colors
    local accent muted_color
    accent=$(get_toml_value "$colors_file" "accent")
    muted_color=$(get_toml_value "$colors_file" "muted")
    if [[ -n "$accent" && -n "$muted_color" ]]; then
        restart_borders "$(hex_to_borders "$accent")" "$(hex_to_borders "$muted_color")"
    else
        print_info "Missing accent/muted colors for borders"
    fi
    
    # 4. Save current theme early so nvim/other tools can read it
    echo "$theme_name" > "$CURRENT_THEME_FILE"
    
    # 5. Update neovim colorscheme
    local nvim_colorscheme nvim_plugin
    nvim_colorscheme=$(get_nvim_colorscheme "$theme_dir")
    nvim_plugin=$(get_nvim_plugin "$theme_dir")
    signal_nvim "$theme_name" "$nvim_colorscheme" "$nvim_plugin"
    
    # 6. Set wallpaper
    set_wallpaper "$theme_dir"
    
    # 7. Update tmux popup colors to match theme
    if command -v tmux &>/dev/null; then
        local popup_bg popup_fg popup_muted
        popup_bg=$(get_toml_value "$colors_file" "background")
        popup_fg=$(get_toml_value "$colors_file" "foreground")
        popup_muted=$(get_toml_value "$colors_file" "muted")
        tmux set -g popup-style "bg=${popup_bg},fg=${popup_fg}" 2>/dev/null || true
        tmux set -g popup-border-style "fg=${popup_muted}" 2>/dev/null || true
        print_success "Tmux popup colors updated"
    fi
    
    echo ""
    print_success "Theme switched to: $theme_name"
}

# Main
case "${1:-}" in
    --list|-l)
        list_themes
        ;;
    --current|-c)
        show_current
        ;;
    --help|-h|"")
        echo "Usage: theme <theme-name> | theme --list | theme --current"
        echo ""
        echo "Commands:"
        echo "  <theme-name>    Switch to the specified theme"
        echo "  --list, -l      List available themes"
        echo "  --current, -c   Show current theme"
        echo "  --help, -h      Show this help"
        echo ""
        echo "Examples:"
        echo "  theme osaka-jade"
        echo "  theme gruvbox"
        echo "  theme --list"
        ;;
    *)
        switch_theme "$1"
        ;;
esac
