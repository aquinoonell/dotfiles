#!/bin/bash
#
# Theme Switcher - Switch nvim, ghostty, sketchybar, and wallpaper themes
# Usage: theme <theme-name> | theme --list | theme --current
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
TEMPLATES_DIR="$DOTFILES_DIR/templates"
CURRENT_THEME_FILE="$HOME/.current-theme"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_info() { echo -e "${BLUE}→${NC} $1"; }

# List available themes
list_themes() {
    echo -e "${BLUE}Available themes:${NC}"
    for theme in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme")
        if [[ -f "$CURRENT_THEME_FILE" ]] && [[ "$(cat "$CURRENT_THEME_FILE")" == "$theme_name" ]]; then
            echo -e "  ${GREEN}● $theme_name${NC} (current)"
        else
            echo "  ○ $theme_name"
        fi
    done
}

# Show current theme
show_current() {
    if [[ -f "$CURRENT_THEME_FILE" ]]; then
        echo "$(cat "$CURRENT_THEME_FILE")"
    else
        echo "No theme set"
    fi
}

# Parse TOML value (simple key = "value" parser)
get_toml_value() {
    local file="$1"
    local key="$2"
    grep "^$key = " "$file" 2>/dev/null | sed 's/.*= "\(.*\)"/\1/' | head -1
}

# Convert hex color to 0xff format (WezTerm template placeholders)
hex_to_borders() {
    local hex="$1"
    echo "0xff${hex:1}"
}

hex_to_sketchy() {
    local hex="$1"
    local alpha="${2:-ff}"
    echo "0x${alpha}${hex:1}"
}

# Point his Lua SketchyBar at the matching palette (sora | cendre) and reload
apply_sketchybar() {
    local colors_file="$1"
    local name
    name=$(basename "$(dirname "$colors_file")")
    local lua="$HOME/dotfiles/sketchybar/colors.lua"
    [[ -f "$lua" ]] || return

    case "$name" in
        sora|cendre) sed -i '' "s/^local theme = \"[^\"]*\"/local theme = \"$name\"/" "$lua" ;;
        *) print_info "SketchyBar has no '$name' palette (only sora/cendre); keeping current" ;;
    esac

    if pgrep -x sketchybar >/dev/null; then
        sketchybar --reload
        print_success "SketchyBar theme updated"
    fi
}

# Fill template with colors
fill_template() {
    local template="$1"
    local output="$2"
    local colors_file="$3"
    local theme_name="$4"
    
    local content
    content=$(cat "$template")
    
    # Replace theme name
    content="${content//\{\{THEME_NAME\}\}/$theme_name}"
    
    # Replace colors
    local keys=(
        "background" "dark_background" "darker_background" "lighter_background"
        "foreground" "dark_foreground" "light_foreground" "bright_foreground"
        "accent" "selection" "muted"
        "red" "yellow" "orange" "green" "cyan" "blue" "magenta" "brown"
        "bright_red" "bright_yellow" "bright_green" "bright_cyan" "bright_blue" "bright_magenta"
    )
    
    for key in "${keys[@]}"; do
        local value
        value=$(get_toml_value "$colors_file" "$key")
        if [[ -n "$value" ]]; then
            content="${content//\{\{$key\}\}/$value}"
        fi
    done
    
    # Replace hex versions for borders (0xff format)
    local accent muted_color
    accent=$(get_toml_value "$colors_file" "accent")
    muted_color=$(get_toml_value "$colors_file" "muted")
    
    content="${content//\{\{accent_hex\}\}/$(hex_to_borders "$accent")}"
    content="${content//\{\{muted_hex\}\}/$(hex_to_borders "$muted_color")}"
    
    echo "$content" > "$output"
}

# Get neovim colorscheme from theme
get_nvim_colorscheme() {
    local theme_dir="$1"
    local nvim_file="$theme_dir/neovim.lua"
    
    if [[ -f "$nvim_file" ]]; then
        # Extract colorscheme name from the lua file
        grep "colorscheme" "$nvim_file" | sed 's/.*colorscheme = "\([^"]*\)".*/\1/' | head -1
    else
        # No dedicated plugin — OmarchyApplyTheme will use colors.toml
        echo "omarchy-$(basename "$theme_dir")"
    fi
}

# Get neovim plugin from theme
get_nvim_plugin() {
    local theme_dir="$1"
    local nvim_file="$theme_dir/neovim.lua"
    
    if [[ -f "$nvim_file" ]]; then
        # Extract plugin name (first quoted string that looks like a plugin)
        grep -E '^\s*"[^/]+/[^"]+"' "$nvim_file" | head -1 | sed 's/.*"\([^"]*\)".*/\1/'
    else
        echo ""
    fi
}

# Set desktop wallpaper (resolves symlinks so macOS gets the real 6K file)
set_wallpaper() {
    local theme_dir="$1"
    local backgrounds_dir="$theme_dir/backgrounds"
    
    if [[ -d "$backgrounds_dir" ]]; then
        local wallpaper=""
        local f
        for f in "$backgrounds_dir"/*; do
            [[ -e "$f" ]] || continue
            case "${f##*.}" in
                jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)
                    wallpaper="$f"
                    break
                    ;;
            esac
        done
        
        if [[ -n "$wallpaper" ]]; then
            # Resolve symlinks — System Events often fails on relative link paths
            local real="$wallpaper"
            if command -v python3 &>/dev/null; then
                real=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$wallpaper")
            elif command -v realpath &>/dev/null; then
                real=$(realpath "$wallpaper")
            fi
            osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"$real\"" 2>/dev/null \
                || osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$real\"" 2>/dev/null
            print_success "Wallpaper set"
        else
            print_info "No wallpaper found for this theme"
        fi
    else
        print_info "No backgrounds directory for this theme"
    fi
}

# Signal neovim to reload colorscheme
signal_nvim() {
    local theme_name="$1"
    local colorscheme="$2"
    local plugin="$3"
    
    # Write to files for next nvim startup
    echo "$colorscheme" > "$HOME/.nvim-colorscheme"
    echo "$plugin" > "$HOME/.nvim-colorscheme-plugin"
    
    # Send full theme apply to all running nvim instances
    if command -v nvr &>/dev/null; then
        local found=0
        # Use OmarchyApplyTheme which loads plugins + falls back to colors.toml
        # Keep everything inside :lua — "|" after :lua is invalid Lua
        local reload_cmd="<Esc>:lua if OmarchyApplyTheme then OmarchyApplyTheme('${theme_name}') end; pcall(vim.cmd, 'AirlineRefresh'); vim.cmd('redraw!')<CR>"
        
        # Fast socket search (macOS TMPDIR + /tmp only, limited depth)
        local search_roots=()
        [[ -n "${TMPDIR:-}" ]] && search_roots+=("$TMPDIR")
        search_roots+=("/tmp")
        
        while IFS= read -r sock; do
            if [[ -S "$sock" ]]; then
                nvr --servername "$sock" --remote-send "$reload_cmd" 2>/dev/null || true
                found=1
            fi
        done < <(find "${search_roots[@]}" -maxdepth 4 -name 'nvim.*.0' -type s 2>/dev/null)
        
        if [[ $found -eq 1 ]]; then
            print_success "Neovim theme: $theme_name (reloaded)"
        else
            print_success "Neovim theme set to: $theme_name"
        fi
    else
        print_success "Neovim theme set to: $theme_name"
        print_info "Restart nvim to apply (install neovim-remote for live reload)"
    fi
}

# Main theme switch function
switch_theme() {
    local theme_name="$1"
    local theme_dir="$THEMES_DIR/$theme_name"
    local colors_file="$theme_dir/colors.toml"
    
    # Validate theme exists
    if [[ ! -d "$theme_dir" ]]; then
        print_error "Theme '$theme_name' not found"
        echo "Run 'theme --list' to see available themes"
        exit 1
    fi
    
    if [[ ! -f "$colors_file" ]]; then
        print_error "No colors.toml found for theme '$theme_name'"
        exit 1
    fi
    
    echo -e "${BLUE}Switching to theme: ${YELLOW}$theme_name${NC}"
    echo ""
    
    # 1. Ghostty theme (themes/<name> embeds its own palette + background)
    local ghostty_dir="$HOME/dotfiles/ghostty"
    if [[ -d "$ghostty_dir" ]]; then
        local gtheme="$ghostty_dir/themes/$theme_name"
        if [[ ! -f "$gtheme" ]]; then
            # No hand-made Ghostty theme for this one: build it from colors.toml
            local g
            g() { local v; v=$(get_toml_value "$colors_file" "$1"); echo "${v:-$2}"; }
            local fg bg acc muted
            bg=$(g background "#000000"); fg=$(g foreground "#ffffff")
            acc=$(g accent "$fg"); muted=$(g muted "$fg")
            cat > "$gtheme" << EOF
# ${theme_name} - generated by theme switcher
background = ${bg}
foreground = ${fg}
cursor-color = ${acc}
cursor-text = ${bg}
selection-foreground = $(g bright_foreground "$fg")
selection-background = $(g selection "#504945")

palette = 0=${bg}
palette = 1=$(g red "#ea6962")
palette = 2=$(g green "#a9b665")
palette = 3=$(g yellow "#d8a657")
palette = 4=$(g blue "$acc")
palette = 5=$(g magenta "#d3869b")
palette = 6=$(g cyan "#89b482")
palette = 7=${muted}
palette = 8=${muted}
palette = 9=$(g bright_red "$(g red "#ea6962")")
palette = 10=$(g bright_green "$(g green "#a9b665")")
palette = 11=$(g bright_yellow "$(g yellow "#d8a657")")
palette = 12=$(g bright_blue "$(g blue "$acc")")
palette = 13=$(g bright_magenta "$(g magenta "#d3869b")")
palette = 14=$(g bright_cyan "$(g cyan "#89b482")")
palette = 15=${fg}
EOF
        fi
        sed -i '' -E "s/^theme = .*/theme = ${theme_name}/" "$ghostty_dir/config"
        # Ghostty reloads its config on SIGUSR2
        pgrep -x ghostty >/dev/null && pkill -USR2 -x ghostty
        print_success "Ghostty theme updated"
    fi
    
    # 2. SketchyBar palette (cache + reload)
    apply_sketchybar "$colors_file"
    
    # 3. Save current theme early so nvim/other tools can read it
    echo "$theme_name" > "$CURRENT_THEME_FILE"
    
    # 4. Update neovim colorscheme
    local nvim_colorscheme nvim_plugin
    nvim_colorscheme=$(get_nvim_colorscheme "$theme_dir")
    nvim_plugin=$(get_nvim_plugin "$theme_dir")
    signal_nvim "$theme_name" "$nvim_colorscheme" "$nvim_plugin"
    
    # 5. Set wallpaper
    set_wallpaper "$theme_dir"
    
    # 6. Update tmux popup colors to match theme
    if command -v tmux &>/dev/null; then
        local popup_bg popup_fg popup_muted
        popup_bg=$(get_toml_value "$colors_file" "background")
        popup_fg=$(get_toml_value "$colors_file" "foreground")
        popup_muted=$(get_toml_value "$colors_file" "muted")
        tmux set -g popup-style "bg=${popup_bg},fg=${popup_fg}" 2>/dev/null || true
        tmux set -g popup-border-style "fg=${popup_muted}" 2>/dev/null || true
        # Prefer Sora tokyo-night slot when on sora
        if [[ "$theme_name" == "sora" ]]; then
            tmux set -g @tokyo-night-tmux_theme "sora" 2>/dev/null || true
            tmux set -g mode-style "fg=#dce4f0,bg=#1e2430" 2>/dev/null || true
            tmux set -g pane-border-style "fg=#222838" 2>/dev/null || true
            tmux set -g pane-active-border-style "fg=#80c8e0" 2>/dev/null || true
            tmux source-file "$HOME/.tmux.conf" 2>/dev/null || true
        fi
        print_success "Tmux popup colors updated"
    fi

    # 7. Ported Aejkatappaja surfaces (yazi/lazygit/hunk/bat/btop/fzf/delta/borders)
    apply_stack_surfaces "$theme_name" "$colors_file"
    
    echo ""
    print_success "Theme switched to: $theme_name"
}

# Swap his palette snapshots + borders when the folder theme maps to them
apply_stack_surfaces() {
    local theme_name="$1"
    local colors_file="$2"
    local cfg="$DOTFILES_DIR"
    local palette=""

    case "$theme_name" in
        sora) palette="sora" ;;
        *) palette="" ;;
    esac

    if [[ -n "$palette" ]]; then
        [[ -f "$cfg/yazi/themes/${palette}.toml" ]] && cp "$cfg/yazi/themes/${palette}.toml" "$cfg/yazi/theme.toml" && print_success "yazi → $palette"
        [[ -f "$cfg/lazygit/${palette}.yml" ]] && cp "$cfg/lazygit/${palette}.yml" "$cfg/lazygit/config.yml" && print_success "lazygit → $palette"
        [[ -f "$cfg/hunk/${palette}.toml" ]] && cp "$cfg/hunk/${palette}.toml" "$cfg/hunk/config.toml" && print_success "hunk → $palette"
        [[ -f "$cfg/fzf/${palette}.fzf" ]] && cp "$cfg/fzf/${palette}.fzf" "$cfg/fzf/current.fzf" && print_success "fzf → $palette"
        if [[ -f "$cfg/bat/config" ]]; then
            # bat theme display name is capitalized in .tmTheme
            local bat_name
            bat_name="$(echo "${palette:0:1}" | tr '[:lower:]' '[:upper:]')${palette:1}"
            sed -i '' -E "s/^--theme=.*/--theme=\"${bat_name}\"/" "$cfg/bat/config"
            print_success "bat → $bat_name"
        fi
        if [[ -f "$cfg/btop/btop.conf" ]]; then
            if rg -q '^color_theme' "$cfg/btop/btop.conf"; then
                sed -i '' -E "s|^color_theme = .*|color_theme = \"${palette}\"|" "$cfg/btop/btop.conf"
            else
                echo "color_theme = \"${palette}\"" >> "$cfg/btop/btop.conf"
            fi
            print_success "btop → $palette"
        fi
        if [[ -f "$HOME/.gitconfig" && -f "$cfg/git/${palette}.gitconfig" ]]; then
            if ! rg -q "git/${palette}\\.gitconfig" "$HOME/.gitconfig"; then
                # replace any prior include of our palette gitconfigs, or append
                if rg -q 'path = .*/dotfiles/git/.*\.gitconfig' "$HOME/.gitconfig"; then
                    sed -i '' -E "s|path = .*/dotfiles/git/.*\\.gitconfig|path = $cfg/git/${palette}.gitconfig|" "$HOME/.gitconfig"
                else
                    printf '\n[include]\n\tpath = %s/git/%s.gitconfig\n' "$cfg" "$palette" >> "$HOME/.gitconfig"
                fi
            fi
            print_success "git-delta → $palette"
        fi
        if [[ -f "$cfg/opencode/tui.json" ]]; then
            python3 - "$cfg/opencode/tui.json" "$palette" <<'PY'
import json, sys
path, pal = sys.argv[1], sys.argv[2]
try:
    data = json.loads(open(path).read())
except Exception:
    data = {}
data["theme"] = pal
open(path, "w").write(json.dumps(data, indent=2) + "\n")
PY
            print_success "opencode → $palette"
        fi
    fi

    # Borders: push accent live
    local accent
    accent=$(get_toml_value "$colors_file" "accent")
    if [[ -n "$accent" ]] && pgrep -x borders >/dev/null; then
        local hex="0xff${accent:1}"
        borders "active_color=${hex}" >/dev/null 2>&1 || true
        # Persist into bordersrc when on sora
        if [[ "$theme_name" == "sora" && -f "$cfg/borders/bordersrc" ]]; then
            sed -i '' -E "s|^[[:space:]]*active_color=.*|	active_color=0xFF80C8E0|" "$cfg/borders/bordersrc"
        fi
        print_success "borders accent updated"
    fi
}

# Main
case "${1:-}" in
    --list|-l)
        list_themes
        ;;
    --current|-c)
        show_current
        ;;
    --help|-h|"")
        echo "Usage: theme <theme-name> | theme --list | theme --current"
        echo ""
        echo "Commands:"
        echo "  <theme-name>    Switch to the specified theme"
        echo "  --list, -l      List available themes"
        echo "  --current, -c   Show current theme"
        echo "  --help, -h      Show this help"
        echo ""
        echo "Examples:"
        echo "  theme osaka-jade"
        echo "  theme gruvbox"
        echo "  theme --list"
        ;;
    *)
        switch_theme "$1"
        ;;
esac
