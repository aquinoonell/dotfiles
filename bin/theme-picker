#!/bin/bash
#
# Visual theme + wallpaper picker (grouped list, color preview)
#

set -e

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$HOME/dotfiles/bin:${PATH:-}"

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
CURRENT_THEME_FILE="$HOME/.current-theme"

if ! command -v fzf &>/dev/null; then
    echo "fzf required. Install: brew install fzf"
    exit 1
fi

if [[ "${1:-}" == "--preload" ]]; then
    "$DOTFILES_DIR/bin/theme-picker-cache" --cache-only
    exit 0
fi

current_theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")

get_theme_color() {
    grep "^$1 = " "$THEMES_DIR/$current_theme/colors.toml" 2>/dev/null | cut -d'"' -f2
}
bg=$(get_theme_color background); bg="${bg:-#282828}"
fg=$(get_theme_color foreground); fg="${fg:-#ebdbb2}"
accent=$(get_theme_color accent); accent="${accent:-#d79921}"
selection=$(get_theme_color selection); selection="${selection:-#504945}"
muted=$(get_theme_color muted); muted="${muted:-#928374}"

if command -v tmux &>/dev/null && [[ -n "${TMUX:-}" ]]; then
    tmux set -g popup-style "bg=${bg},fg=${fg}" 2>/dev/null || true
    tmux set -g popup-border-style "fg=${muted}" 2>/dev/null || true
fi

fzf_colors="bg:${bg},fg:${fg},hl:${accent}"
fzf_colors+=",bg+:${selection},fg+:${fg},hl+:${accent}"
fzf_colors+=",info:${muted},prompt:${accent},pointer:${accent}"
fzf_colors+=",marker:${accent},spinner:${accent},header:${muted}"
fzf_colors+=",border:${muted},gutter:${bg}"
# Explicit preview fg/bg — without preview-fg, reset text is invisible on dark themes
fzf_colors+=",preview-bg:${bg},preview-fg:${fg}"
fzf_colors+=",separator:${muted},scrollbar:${muted},preview-border:${muted}"
fzf_colors+=",preview-scrollbar:${muted},label:${fg},preview-label:${fg}"

build_list() {
    for theme_dir in "$THEMES_DIR"/*/; do
        [[ -d "$theme_dir" ]] || continue
        theme_name=$(basename "$theme_dir")
        bg_dir="$theme_dir/backgrounds"

        if [[ "$theme_name" == "$current_theme" ]]; then
            marker="●"
        else
            marker="○"
        fi

        echo "$marker $theme_name"

        if [[ -d "$bg_dir" ]]; then
            find "$bg_dir" -maxdepth 1 -type f \
                \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
                2>/dev/null | sort | while IFS= read -r wallpaper; do
                echo "  $theme_name/$(basename "$wallpaper")"
            done
        fi
    done
}

selected=$(build_list | fzf \
    --prompt="Theme: " \
    --header="Current: $current_theme │ theme or wallpaper │ Enter=apply" \
    --preview="$DOTFILES_DIR/bin/theme-preview {}" \
    --preview-window=right:50%:wrap \
    --height=100% \
    --layout=reverse \
    --border \
    --ansi \
    --no-sort \
    --color="$fzf_colors" \
    || true)

[[ -z "$selected" ]] && exit 0

if [[ "$selected" =~ ^[●○] ]]; then
    theme_name="${selected#* }"
    "$DOTFILES_DIR/bin/theme" "$theme_name"
else
    trimmed="${selected#  }"
    theme_name="${trimmed%%/*}"
    bg_name="${trimmed#*/}"

    "$DOTFILES_DIR/bin/theme" "$theme_name"

    bg_path="$THEMES_DIR/$theme_name/backgrounds/$bg_name"
    if [[ -f "$bg_path" ]]; then
        osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$bg_path\"" 2>/dev/null
        echo "✓ Wallpaper: $bg_name"
    fi
fi
