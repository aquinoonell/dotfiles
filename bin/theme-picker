#!/bin/bash
#
# Visual theme picker — omarchy-style (cached previews, filterable carousel in fzf)
# Wallpapers: use `wallpaper` separately (like omarchy-theme-bg-switcher)
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
CURRENT_THEME_FILE="$HOME/.current-theme"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/theme-selector"
PREVIEW_DIR="$CACHE_DIR/previews"

if ! command -v fzf &>/dev/null; then
    echo "fzf required. Install: brew install fzf"
    exit 1
fi

if [[ "${1:-}" == "--preload" ]]; then
    "$DOTFILES_DIR/bin/theme-picker-cache" --cache-only
    exit 0
fi

current_theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")

"$DOTFILES_DIR/bin/theme-picker-cache" --cache-only

get_theme_color() {
    grep "^$1 = " "$THEMES_DIR/$current_theme/colors.toml" 2>/dev/null | cut -d'"' -f2
}
bg=$(get_theme_color background); bg="${bg:-#282828}"
fg=$(get_theme_color foreground); fg="${fg:-#ebdbb2}"
accent=$(get_theme_color accent); accent="${accent:-#d79921}"
selection=$(get_theme_color selection); selection="${selection:-#504945}"
muted=$(get_theme_color muted); muted="${muted:-#928374}"

if command -v tmux &>/dev/null && [[ -n "${TMUX:-}" ]]; then
    tmux set -g popup-style "bg=${bg},fg=${fg}" 2>/dev/null || true
    tmux set -g popup-border-style "fg=${muted}" 2>/dev/null || true
fi

fzf_colors="bg:${bg},fg:${fg},hl:${accent}"
fzf_colors+=",bg+:${selection},fg+:${fg},hl+:${accent}"
fzf_colors+=",info:${muted},prompt:${accent},pointer:${accent}"
fzf_colors+=",marker:${accent},spinner:${accent},header:${muted}"
fzf_colors+=",border:${muted},gutter:${bg},preview-bg:${bg}"

build_list() {
    for theme_dir in "$THEMES_DIR"/*/; do
        [[ -d "$theme_dir" ]] || continue
        theme=$(basename "$theme_dir")
        thumb="$PREVIEW_DIR/$theme.jpg"
        if [[ "$theme" == "$current_theme" ]]; then
            marker="●"
        else
            marker="○"
        fi
        if [[ -f "$thumb" ]]; then
            echo "${marker}|${theme}|${thumb}"
        else
            echo "${marker}|${theme}|"
        fi
    done | sort -t'|' -k2
}

selected=$(build_list | fzf \
    --prompt="Theme: " \
    --header="Current: $current_theme │ filter │ Enter=apply │ wallpapers: wallpaper" \
    --delimiter='|' \
    --with-nth=2 \
    --preview='
        thumb={3}
        theme={2}
        if [[ -n "$thumb" && -f "$thumb" ]] && command -v wezterm >/dev/null; then
            wezterm imgcat "$thumb" 2>/dev/null
        fi
        '"$DOTFILES_DIR"'/bin/theme-preview "$theme"
    ' \
    --preview-window=right:50% \
    --height=100% \
    --layout=reverse \
    --border \
    --ansi \
    --no-sort \
    --color="$fzf_colors" \
    || true)

[[ -z "$selected" ]] && exit 0

theme_name=$(echo "$selected" | cut -d'|' -f2)
[[ -n "$theme_name" ]] && "$DOTFILES_DIR/bin/theme" "$theme_name"
