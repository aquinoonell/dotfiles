#!/bin/bash
#
# Theme Picker - Simple interactive theme selector using fzf
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
CURRENT_THEME_FILE="$HOME/.current-theme"

if ! command -v fzf &>/dev/null; then
    echo "fzf is required. Install with: brew install fzf"
    exit 1
fi

current_theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")

# Build list
build_list() {
    for theme_dir in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme_dir")
        bg_dir="$theme_dir/backgrounds"
        
        if [[ "$theme_name" == "$current_theme" ]]; then
            marker="●"
        else
            marker="○"
        fi
        
        # Theme header
        echo "$marker $theme_name"
        
        # Wallpapers
        if [[ -d "$bg_dir" ]]; then
            for bg in "$bg_dir"/*.jpg "$bg_dir"/*.jpeg "$bg_dir"/*.png "$bg_dir"/*.webp; do
                [[ -f "$bg" ]] && echo "    └ $(basename "$bg")"
            done
        fi
    done
}

# Simple text preview showing colors
preview_colors() {
    local line="$1"
    if [[ "$line" =~ ^[●○] ]]; then
        theme="${line#* }"
    else
        # Get theme from indented wallpaper line by finding parent
        return
    fi
    
    local colors_file="$THEMES_DIR/$theme/colors.toml"
    if [[ -f "$colors_file" ]]; then
        cat "$colors_file"
    fi
}

selected=$(build_list | fzf \
    --prompt="Theme: " \
    --header="Current: $current_theme" \
    --preview='
        line={}
        if [[ "$line" =~ ^[●○] ]]; then
            theme="${line#* }"
            cat "'"$THEMES_DIR"'/$theme/colors.toml" 2>/dev/null
        fi
    ' \
    --preview-window=right:40% \
    --height=80% \
    --layout=reverse \
    --border \
    --ansi \
    --no-sort \
    || true)

[[ -z "$selected" ]] && exit 0

# Parse selection
if [[ "$selected" =~ ^[●○] ]]; then
    theme_name="${selected#* }"
    "$DOTFILES_DIR/bin/theme" "$theme_name"
else
    # Wallpaper selected - need to find parent theme
    # For now just ignore wallpaper selections
    echo "Select a theme (● or ○ line)"
fi
