#!/bin/bash
#
# Theme Picker - Interactive theme selector using fzf
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
CURRENT_THEME_FILE="$HOME/.current-theme"

if ! command -v fzf &>/dev/null; then
    echo "fzf is required. Install with: brew install fzf"
    exit 1
fi

current_theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")

# Build list with theme:wallpaper format for easy parsing
build_list() {
    for theme_dir in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme_dir")
        bg_dir="$theme_dir/backgrounds"
        
        if [[ "$theme_name" == "$current_theme" ]]; then
            marker="●"
        else
            marker="○"
        fi
        
        # Theme header
        echo "$marker $theme_name"
        
        # Wallpapers
        if [[ -d "$bg_dir" ]]; then
            for bg in "$bg_dir"/*.jpg "$bg_dir"/*.jpeg "$bg_dir"/*.png "$bg_dir"/*.webp; do
                [[ -f "$bg" ]] && echo "  $theme_name/$(basename "$bg")"
            done
        fi
    done
}

selected=$(build_list | fzf \
    --prompt="Theme: " \
    --header="Current: $current_theme │ Select theme or wallpaper" \
    --preview="$DOTFILES_DIR/bin/theme-preview {}" \
    --preview-window=right:45% \
    --height=80% \
    --layout=reverse \
    --border \
    --ansi \
    --no-sort \
    || true)

[[ -z "$selected" ]] && exit 0

# Parse selection
if [[ "$selected" =~ ^[●○] ]]; then
    # Theme header
    theme_name="${selected#* }"
    "$DOTFILES_DIR/bin/theme" "$theme_name"
else
    # Wallpaper line
    trimmed="${selected#  }"
    theme_name="${trimmed%%/*}"
    bg_name="${trimmed#*/}"
    
    # Apply theme
    "$DOTFILES_DIR/bin/theme" "$theme_name"
    
    # Set specific wallpaper
    bg_path="$THEMES_DIR/$theme_name/backgrounds/$bg_name"
    if [[ -f "$bg_path" ]]; then
        osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$bg_path\"" 2>/dev/null
        echo "✓ Wallpaper: $bg_name"
    fi
fi
