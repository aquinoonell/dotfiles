#!/bin/bash
#
# Theme Picker - Interactive theme selector using fzf
# The picker UI matches the current theme
#

set -e

DOTFILES_DIR="$HOME/dotfiles"
THEMES_DIR="$DOTFILES_DIR/themes"
CURRENT_THEME_FILE="$HOME/.current-theme"

if ! command -v fzf &>/dev/null; then
    echo "fzf is required. Install with: brew install fzf"
    exit 1
fi

current_theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")

# Get colors from current theme for fzf styling
get_theme_color() {
    local colors_file="$THEMES_DIR/$current_theme/colors.toml"
    grep "^$1 = " "$colors_file" 2>/dev/null | cut -d'"' -f2
}

# Read current theme colors
bg=$(get_theme_color background)
fg=$(get_theme_color foreground)
accent=$(get_theme_color accent)
selection=$(get_theme_color selection)
muted=$(get_theme_color muted)

# Default fallbacks
bg="${bg:-#282828}"
fg="${fg:-#ebdbb2}"
accent="${accent:-#d79921}"
selection="${selection:-#504945}"
muted="${muted:-#928374}"

# Build fzf color scheme from current theme
fzf_colors="bg:${bg},fg:${fg},hl:${accent}"
fzf_colors+=",bg+:${selection},fg+:${fg},hl+:${accent}"
fzf_colors+=",info:${muted},prompt:${accent},pointer:${accent}"
fzf_colors+=",marker:${accent},spinner:${accent},header:${muted}"
fzf_colors+=",border:${muted},gutter:${bg},preview-bg:${bg}"

# Build list with theme:wallpaper format
build_list() {
    for theme_dir in "$THEMES_DIR"/*/; do
        theme_name=$(basename "$theme_dir")
        bg_dir="$theme_dir/backgrounds"
        
        if [[ "$theme_name" == "$current_theme" ]]; then
            marker="●"
        else
            marker="○"
        fi
        
        # Theme header
        echo "$marker $theme_name"
        
        # Wallpapers
        if [[ -d "$bg_dir" ]]; then
            for bg in "$bg_dir"/*.jpg "$bg_dir"/*.jpeg "$bg_dir"/*.png "$bg_dir"/*.webp; do
                [[ -f "$bg" ]] && echo "  $theme_name/$(basename "$bg")"
            done
        fi
    done
}

selected=$(build_list | fzf \
    --prompt="Theme: " \
    --header="Current: $current_theme │ Select theme or wallpaper" \
    --preview="$DOTFILES_DIR/bin/theme-preview {}" \
    --preview-window=right:45% \
    --height=80% \
    --layout=reverse \
    --border \
    --ansi \
    --no-sort \
    --color="$fzf_colors" \
    || true)

[[ -z "$selected" ]] && exit 0

# Parse selection
if [[ "$selected" =~ ^[●○] ]]; then
    # Theme header
    theme_name="${selected#* }"
    "$DOTFILES_DIR/bin/theme" "$theme_name"
else
    # Wallpaper line
    trimmed="${selected#  }"
    theme_name="${trimmed%%/*}"
    bg_name="${trimmed#*/}"
    
    # Apply theme
    "$DOTFILES_DIR/bin/theme" "$theme_name"
    
    # Set specific wallpaper
    bg_path="$THEMES_DIR/$theme_name/backgrounds/$bg_name"
    if [[ -f "$bg_path" ]]; then
        osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$bg_path\"" 2>/dev/null
        echo "✓ Wallpaper: $bg_name"
    fi
fi
