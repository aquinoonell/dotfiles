#!/bin/bash
#
# Toggle JankyBorders on/off
# Usage: borders-toggle [on|off|toggle|status]
#
# Uses brew services to manage launchd so KeepAlive doesn't fight theme changes.
#

DOTFILES_DIR="$HOME/dotfiles"
CURRENT_THEME_FILE="$HOME/.current-theme"
THEMES_DIR="$DOTFILES_DIR/themes"

# Get current theme colors
get_border_colors() {
    local theme=$(cat "$CURRENT_THEME_FILE" 2>/dev/null || echo "gruvbox")
    local colors_file="$THEMES_DIR/$theme/colors.toml"
    
    if [[ -f "$colors_file" ]]; then
        local accent=$(grep "^accent = " "$colors_file" | cut -d'"' -f2)
        local muted=$(grep "^muted = " "$colors_file" | cut -d'"' -f2)
        echo "${accent:-#509475}" "${muted:-#53685B}"
    else
        echo "#509475" "#53685B"
    fi
}

# Write bordersrc so brew service restarts stay themed
write_bordersrc() {
    local accent_hex="$1"
    local muted_hex="$2"
    
    mkdir -p "$HOME/.config/borders"
    cat > "$HOME/.config/borders/bordersrc" << EOF
#!/bin/bash
borders active_color="$accent_hex" inactive_color="$muted_hex" width=6.0
EOF
    chmod +x "$HOME/.config/borders/bordersrc"
}

borders_on() {
    read -r accent muted <<< "$(get_border_colors)"
    # Convert to 0xff format
    accent_hex="0xff${accent:1}"
    muted_hex="0xff${muted:1}"
    
    rm -f "$HOME/.borders-disabled"
    
    # Write bordersrc so service restarts stay themed
    write_bordersrc "$accent_hex" "$muted_hex"
    
    # Start via brew services (launchd-managed, respects KeepAlive)
    if command -v brew &>/dev/null && brew services list 2>/dev/null | grep -q "^borders"; then
        brew services start borders 2>/dev/null || true
        sleep 0.3
        # IPC apply colors after brew starts it
        if pgrep -x borders >/dev/null; then
            borders active_color="$accent_hex" inactive_color="$muted_hex" width=6.0
            echo "✓ Borders enabled ($accent_hex)"
            return
        fi
    fi
    
    # Fallback: start directly if brew services unavailable
    borders active_color="$accent_hex" inactive_color="$muted_hex" width=6.0 &
    disown
    sleep 0.2
    if pgrep -x borders >/dev/null; then
        echo "✓ Borders enabled ($accent_hex)"
    else
        echo "✗ Borders failed to start"
    fi
}

borders_off() {
    touch "$HOME/.borders-disabled"
    
    # Stop via brew services first (prevents KeepAlive resurrection)
    if command -v brew &>/dev/null && brew services list 2>/dev/null | grep -q "^borders"; then
        brew services stop borders 2>/dev/null || true
    fi
    
    # pkill as backup in case it wasn't started via brew
    pkill -x borders 2>/dev/null || true
    echo "✓ Borders disabled"
}

borders_status() {
    if [[ -f "$HOME/.borders-disabled" ]]; then
        echo "Borders: disabled (flag set)"
    elif pgrep -x borders >/dev/null; then
        echo "Borders: enabled (running)"
    else
        echo "Borders: stopped"
    fi
}

case "${1:-toggle}" in
    on)
        borders_on
        ;;
    off)
        borders_off
        ;;
    toggle)
        if [[ -f "$HOME/.borders-disabled" ]]; then
            borders_on
        elif pgrep -x borders >/dev/null; then
            borders_off
        else
            borders_on
        fi
        ;;
    status)
        borders_status
        ;;
    *)
        echo "Usage: borders-toggle [on|off|toggle|status]"
        ;;
esac
