#!/bin/bash
# Install full 6K Mekanikos wallpapers and link ALL of them into themes.
#
# Usage: mekanikos-wallpapers [path-to-zip]

set -e

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"
ZIP="${1:-$HOME/Downloads/Mekanikos Wallpapers 1.0.zip}"
DEST="$DOTFILES_DIR/wallpapers/mekanikos"
TMP="${TMPDIR:-/tmp}/mekanikos-extract-$$"

if [[ ! -f "$ZIP" ]]; then
  echo "Zip not found: $ZIP"
  echo "Usage: mekanikos-wallpapers /path/to/Mekanikos\\ Wallpapers\\ 1.0.zip"
  exit 1
fi

echo "Extracting desktop PNGs from: $ZIP"
mkdir -p "$TMP" "$DEST/dark" "$DEST/light"
unzip -o -q "$ZIP" \
  "Mekanikos Wallpapers 1.0/Desktop/dark/*" \
  "Mekanikos Wallpapers 1.0/Desktop/light/*" \
  -d "$TMP"

src_dark="$TMP/Mekanikos Wallpapers 1.0/Desktop/dark"
src_light="$TMP/Mekanikos Wallpapers 1.0/Desktop/light"

copy_dir() {
  local src="$1" dest="$2"
  local f base
  for f in "$src"/*.png; do
    [[ -f "$f" ]] || continue
    base=$(basename "$f")
    rm -f "$dest/$base"
    # Hardlink keeps one 6K copy on disk; fall back to copy
    ln "$f" "$dest/$base" 2>/dev/null || cp "$f" "$dest/$base"
  done
}

copy_dir "$src_dark" "$DEST/dark"
copy_dir "$src_light" "$DEST/light"

# Hardlink every wallpaper into theme backgrounds (real files → picker lists them)
link_all() {
  local theme="$1" mode="$2"
  local bgdir="$DOTFILES_DIR/themes/$theme/backgrounds"
  local src="$DEST/$mode"
  mkdir -p "$bgdir"
  rm -f "$bgdir"/*
  local i=1 f base
  for f in "$src"/[0-9][0-9]-*.png; do
    [[ -e "$f" ]] || continue
    base=$(basename "$f")
    # Drop leading NN- for prettier picker names, keep sort order via index
    local short="${base#*-}"
    short="${short%.png}"
    local dest="$bgdir/${i}-${short}.png"
    ln "$f" "$dest" 2>/dev/null || cp "$f" "$dest"
    i=$((i + 1))
  done
  echo "✓ $theme ($(ls "$bgdir" | wc -l | tr -d ' ') × 6K)"
}

echo "Linking all wallpapers into themes…"
link_all mekanikos-mare dark
link_all mekanikos-oracle dark
link_all mekanikos-lantern dark
link_all mekanikos-ferryman dark
link_all mekanikos-light light

rm -rf "$TMP"

# Bust stale low-res previews
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/theme-selector/previews" 2>/dev/null || true

echo ""
echo "Store: $(du -sh "$DEST" | awk '{print $1}') (shared 6K masters)"
echo "Verify: sips -g pixelWidth \"\$HOME/dotfiles/themes/mekanikos-mare/backgrounds/1-\"*.png"
echo "Re-apply: theme \$(cat ~/.current-theme)"
